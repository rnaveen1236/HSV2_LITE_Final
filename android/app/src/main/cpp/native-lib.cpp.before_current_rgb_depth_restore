extern "C" JNIEXPORT jstring JNICALL
Java_com_hsv2_hsv2_1lite_MainActivity_pollTelemetry(
        JNIEnv* env,
        jobject /* this */) {

    if (!isStreaming) {

        return env->NewStringUTF("{}");
    }

    std::string current_telemetry;

    {
        std::lock_guard<std::mutex> lock(
                telemetry_mutex);

        current_telemetry =
                telemetry_json;
